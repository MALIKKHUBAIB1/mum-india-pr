# SMTP config for inquiry emails (Gmail app password)
# SMTP_USER is the Gmail that SENDS (needs App Password), SMTP_TO is where enquiries ARRIVE (comma-separated for multiple)
# Set these in Vercel/Netlify dashboard → Environment Variables
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=khubaib9221@gmail.com
SMTP_PASS=dmfs nnsk gqyl qwke
SMTP_TO=khubaib9221@gmail.com, Info@mumindiapr.com

# Admin panel (/admin) — fixed owner login, works everywhere, no setup needed.
# Email: mumindiaadmin@gmail.com
# Password: admin@1234
# Password resets are emailed via the SMTP settings above.
# Optional hardening for production (else a built-in default is used):
# SESSION_SECRET=any-long-random-string


# Permanent storage for /admin edits (recommended for production).
# Without these, edits are stored in content.db.json / admin-auth.json
# (works on localhost, ephemeral on Vercel/Netlify serverless). Free tier: https://supabase.com
# Run supabase-schema.sql in your Supabase SQL editor, then set:
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key (server-only, never VITE_ prefixed)

# Image uploads via ImageKit (free tier: https://imagekit.io).
# Without these, the admin shows "uploads off" and you paste image URLs manually.
# IMAGEKIT_PUBLIC_KEY=your-public-key
# IMAGEKIT_PRIVATE_KEY=your-private-key (server-only, never VITE_ prefixed)
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# Blog via Sanity CMS (free tier: https://sanity.io, public dataset needs no token).
# Without these, the site shows the built-in static posts.
# SANITY_PROJECT_ID=ha8v9jbz
# SANITY_DATASET=production
# SANITY_READ_TOKEN=only-if-dataset-is-private (server-only, never VITE_ prefixed)
